\newcommand{\stpDepartment}[1]{\def\@stpDepartment{#1}}
\newcommand{\stpSubject}[1]{\def\@stpSubject{#1}}
\newcommand{\stpLabNumber}[1]{\def\@stpLabNumber{#1}}
\newcommand{\stpLabTopic}[1]{\def\@stpLabTopic{#1}}
\newcommand{\stpVariant}[1]{\def\@stpVariant{#1}}
\newcommand{\stpStudent}[1]{\def\@stpStudent{#1}}
\newcommand{\stpGroup}[1]{\def\@stpGroup{#1}}
\newcommand{\stpTeacher}[1]{\def\@stpTeacher{#1}}
