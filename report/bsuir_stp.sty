% --- Команда генерации титульного листа по стандарту БГУИР ---
\newcommand{\makestptitlepage}{%
  \begin{titlepage}
    \thispagestyle{empty}
    \begin{center}
      {\fontsize{12pt}{14pt}\selectfont
      МИНИСТЕРСТВО ОБРАЗОВАНИЯ РЕСПУБЛИКИ БЕЛАРУСЬ\\[6pt]
      УЧРЕЖДЕНИЕ ОБРАЗОВАНИЯ\\[6pt]
      «БЕЛОРУССКИЙ ГОСУДАРСТВЕННЫЙ УНИВЕРСИТЕТ ИНФОРМАТИКИ И РАДИОЭЛЕКТРОНИКИ»\\[8pt]
      \@stpFaculty\\[4pt]
      \@stpDepartment
      }

      \vspace{45pt}

      {\fontsize{14pt}{18pt}\selectfont\bfseries
      ОТЧЕТ\\[6pt]
      по лабораторной работе №\,\@stpLabNumber\\[6pt]
      по дисциплине «\@stpSubject»\\[6pt]
      на тему: «\@stpLabTopic»\\[10pt]
      Вариант №\,\@stpVariant
      }
    \end{center}

    \vspace{50pt}

    \begin{flushright}
      \begin{minipage}{0.35\textwidth}
        \raggedright
        {\fontsize{14pt}{18pt}\selectfont
        \textbf{Выполнил(а):}\\
        студент(ка) гр. \@stpGroup\\
        \@stpStudent\\[12pt]
        \textbf{Проверил:}\\
        \@stpTeacherRole\\
        \@stpTeacher
        }
      \end{minipage}
    \end{flushright}

    \vfill

    \begin{center}
      {\fontsize{14pt}{18pt}\selectfont
      \@stpCity\ \@stpYear
      }
    \end{center}
  \end{titlepage}
  \clearpage
}

